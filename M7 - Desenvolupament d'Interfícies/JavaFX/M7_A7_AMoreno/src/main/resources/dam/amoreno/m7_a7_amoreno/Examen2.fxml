   xmlns:fx="http://javafx.com/fxml/1" fx:controller="dam.amoreno.m7_a7_amoreno.Examen.ControllerExamen2">

   <children>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <ImageView fx:id="imageView1" fitHeight="420.0" fitWidth="530.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </VBox>
      <VBox layoutX="600.0" prefHeight="413.0" prefWidth="600.0" spacing="20.0">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
               <children>
                  <Text id="text" fx:id="textPregunta" text="Pregunta:" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <RadioButton id="radioBtnResposta" fx:id="radioBtnResposta1" mnemonicParsing="false">
                           <toggleGroup>
                              <ToggleGroup fx:id="toggleGroup" />
                           </toggleGroup>
                        </RadioButton>
                        <Text id="text" fx:id="textResposta1" text="Resposta 1:" HBox.hgrow="ALWAYS" />
