                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <RadioButton id="radioBtnResposta" fx:id="radioBtnResposta2" mnemonicParsing="false" toggleGroup="$toggleGroup" />
                        <Text id="text" fx:id="textResposta2" text="Resposta 2:" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <RadioButton id="radioBtnResposta" fx:id="radioBtnResposta3" mnemonicParsing="false" toggleGroup="$toggleGroup" />
                        <Text id="text" fx:id="textResposta3" text="Resposta 3:" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
