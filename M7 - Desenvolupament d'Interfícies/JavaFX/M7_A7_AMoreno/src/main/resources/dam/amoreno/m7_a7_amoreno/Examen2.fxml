      <Button id="btn" fx:id="btnAnterior" onAction="#btnAnterior" alignment="CENTER" layoutX="14.0" layoutY="662.0" mnemonicParsing="false" prefHeight="37.0" prefWidth="150.0" text="Pregunta anterior" />
      <Button id="btn" fx:id="btnSeguent" onAction="#btnSeguent" alignment="CENTER" layoutX="1036.0" layoutY="662.0" mnemonicParsing="false" text="Següent pregunta" />
      <Button id="btn" fx:id="btnFinalitzar" onAction="#btnFinalitzar" alignment="CENTER" layoutX="1036.0" layoutY="714.0" mnemonicParsing="false" prefHeight="40.0" text="Finalitzar examen" />

