<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane id="pane1" fx:id="pane1" maxHeight="800.0" maxWidth="1200.0" minHeight="800.0" minWidth="1200.0" prefHeight="800.0" prefWidth="1200.0" stylesheets="@styles/examen1.css"
   xmlns="http://javafx.com/javafx/23.0.1"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="dam.amoreno.m7_a7_amoreno.Examen.ControllerExamen1">

   <children>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <ChoiceBox fx:id="desplegable1" prefHeight="30.0" prefWidth="220.0" />
            <ImageView fx:id="imageView1" fitHeight="420.0" fitWidth="530.0" pickOnBounds="true" preserveRatio="true" />
            <Button id="btn" fx:id="btnImageView" mnemonicParsing="false" onAction="#seleccionarImatge" text="Seleccionar imatge DNI" />
         </children>
      </VBox>
      <VBox layoutX="600.0" prefHeight="413.0" prefWidth="600.0" spacing="20.0">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <TextField id="textField" fx:id="textFieldDNI" promptText="DNI:" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                     <children>
                        <TextField id="textField" fx:id="textFieldNom" promptText="Nom complert:" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>


      <Button id="btn" fx:id="btnExamen" alignment="CENTER" layoutX="1036.0" layoutY="714.0" mnemonicParsing="false" onAction="#comencarExamen" prefHeight="40.0" text="Començar examen" />

   </children>
</Pane>
